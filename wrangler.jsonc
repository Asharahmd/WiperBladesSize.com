// Cloudflare Workers static-assets deploy: `npm run build` writes out/, then `npx wrangler deploy` uploads it.
{
  "name": "wiperbladessize-com",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./out",
    // trailingSlash: true pages live at /x/index.html; unknown paths get out/404.html with a 404 status.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
